{
  "version": "office-v0",
  "layers": [
    {
      "name": "context",
      "order": 0
    },
    {
      "name": "extract",
      "order": 1
    },
    {
      "name": "compose",
      "order": 2
    },
    {
      "name": "verify",
      "order": 3
    },
    {
      "name": "render",
      "order": 4
    }
  ],
  "tools": [
    {
      "name": "chart_data_check",
      "layer": "verify",
      "implementation": "examples.office.tools_det:chart_data_check",
      "consumes": [
        "examples.office.facts:ChartSpec",
        "examples.office.facts:DataTable"
      ],
      "produces": [
        "examples.office.facts:ReviewReport"
      ],
      "capabilities": [
        "chart.check"
      ],
      "description": "Rule check: chart series matches the source table values",
      "cost_per_call": 0.001
    },
    {
      "name": "chart_prepare",
      "layer": "extract",
      "implementation": "examples.office.tools_det:chart_prepare",
      "consumes": [
        "examples.office.facts:DataTable"
      ],
      "produces": [
        "examples.office.facts:ChartSpec"
      ],
      "capabilities": [
        "chart.prepare"
      ],
      "description": "Prepare a bar chart series from the last numeric column",
      "cost_per_call": 0.001
    },
    {
      "name": "chart_type_pick_llm",
      "layer": "compose",
      "implementation": "examples.office.tools_llm:chart_type_pick_llm",
      "consumes": [
        "examples.office.facts:ChartSpec"
      ],
      "produces": [
        "examples.office.facts:ChartSpec"
      ],
      "capabilities": [
        "chart.select"
      ],
      "description": "LLM chart kind pick (redundant with the rule variant)",
      "cost_per_call": 0.004
    },
    {
      "name": "chart_type_pick_rule",
      "layer": "compose",
      "implementation": "examples.office.tools_llm:chart_type_pick_rule",
      "consumes": [
        "examples.office.facts:ChartSpec"
      ],
      "produces": [
        "examples.office.facts:ChartSpec"
      ],
      "capabilities": [
        "chart.select"
      ],
      "description": "Rule-based chart kind pick (redundant with the LLM variant)",
      "cost_per_call": 0.0005
    },
    {
      "name": "data_aggregate",
      "layer": "extract",
      "implementation": "examples.office.tools_det:data_aggregate",
      "consumes": [
        "examples.office.facts:DataTable"
      ],
      "produces": [
        "examples.office.facts:AggregateResult"
      ],
      "capabilities": [
        "data.aggregate"
      ],
      "description": "Group by the first column and sum the last numeric column",
      "cost_per_call": 0.002
    },
    {
      "name": "deck_parse",
      "layer": "context",
      "implementation": "examples.office.tools_l0:deck_parse",
      "produces": [
        "examples.office.facts:SlideDigest"
      ],
      "capabilities": [
        "ppt.parse"
      ],
      "description": "Parse the json corpus deck into a SlideDigest",
      "cost_per_call": 0.002
    },
    {
      "name": "doc_composed_report",
      "layer": "compose",
      "kind": "composite",
      "inner": "doc_composed_report_inner.json",
      "route": [
        {
          "layer": "c_draft",
          "tools": [
            "draft_step"
          ]
        },
        {
          "layer": "c_check",
          "tools": [
            "check_step"
          ]
        },
        {
          "layer": "c_polish",
          "tools": [
            "polish_step"
          ]
        },
        {
          "layer": "c_release",
          "tools": [
            "report_release",
            "report_holdover"
          ]
        }
      ],
      "stop_when": [
        "draft"
      ],
      "max_iterations": 3,
      "consumes": [
        "examples.office.facts:SourceDoc",
        "examples.office.facts:FactSheet"
      ],
      "produces": [
        "examples.office.facts:Draft"
      ],
      "capabilities": [
        "doc.composed_report"
      ],
      "description": "Bounded draft->length-check->polish->release loop producing a self-checked Draft (deterministic two-iteration convergence)",
      "cost_per_call": 0.0061
    },
    {
      "name": "doc_length_check",
      "layer": "verify",
      "implementation": "examples.office.tools_det:doc_length_check",
      "consumes": [
        "examples.office.facts:Draft"
      ],
      "produces": [
        "examples.office.facts:ReviewReport"
      ],
      "capabilities": [
        "doc.length"
      ],
      "description": "Rule check: body word count and section headings",
      "cost_per_call": 0.0005
    },
    {
      "name": "doc_parse",
      "layer": "context",
      "implementation": "examples.office.tools_l0:doc_parse",
      "produces": [
        "examples.office.facts:SourceDoc"
      ],
      "capabilities": [
        "doc.parse"
      ],
      "description": "Parse the restricted-markdown corpus document",
      "cost_per_call": 0.001
    },
    {
